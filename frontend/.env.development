# Origen de la API (HTTPS, perfil "https" del launchSettings). Si incluyes /swagger/..., se ignora esa ruta al llamar a /api/...
VITE_API_BASE_URL=https://localhost:7282/swagger/index.html
# iPhone/iPad en dev: si abres el front como http://<IP-PC>:5173, la API se usa sola en http://<misma-IP>:5183 (ver getApiBase).
# Para forzar siempre una URL: descomenta y ajusta — p. ej. http://192.168.1.50:5183

# Precarga del mazo al abrir la app (solo `npm run dev` / `vite preview`): Vite sirve el archivo desde disco.
DEMOENGLISH_PRELOAD_APKG_PATH=C:\Users\migue\Music\4000_Essential_English_Words_all_books_en-en.apkg
VITE_PRELOAD_APKG_URL=/__preload-demo-apkg
